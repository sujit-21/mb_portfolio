# Server Environment Variables Configuration
# Copy this file to .env and customize with your credentials

PORT=5000
# MongoDB Atlas Connection String (Recommended):
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/manish_portfolio?retryWrites=true&w=majority
# Or Local MongoDB (Optional):
# MONGODB_URI=mongodb://127.0.0.1:27017/manish_portfolio_v2
CLIENT_URL=http://localhost:5173

NODE_ENV=development

# Administrator Authentication
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password_here
JWT_SECRET=your_jwt_secret_key_here
ADMIN_RECOVERY_HINT=Hint for administrative password recovery

# Email Service Configuration (Nodemailer / SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here

# Optional: Resend API Key for Transactional Emails
RESEND_API_KEY=your_resend_api_key_here
